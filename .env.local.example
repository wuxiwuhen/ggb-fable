# ──────────────────────────────────────────────────────────────
# GGB Fable 环境变量
# 复制本文件为 .env.local 并填入真实值(.env.local 已在 .gitignore, 不会进 git)
# 生产环境把同样的变量配到 Vercel 后台
# ──────────────────────────────────────────────────────────────

# ── 免费模式: 你预置的 LLM key(仅后端 serverless 读取, 永不返回前端) ──
# 模型1: DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 模型2: 智谱 GLM (对话 + embedding 检索 + 视觉 OCR)
GLM_API_KEY=your-glm-key
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.6
GLM_EMBEDDING_MODEL=embedding-3
GLM_VISION_MODEL=glm-4.6v

# 免费模式默认使用哪个模型 (deepseek | glm)
TRIAL_DEFAULT_MODEL=deepseek

# ── 防失控: 单次用户发送(一个意图)的软上限 ──
# 已与你确认放宽: 30 轮工具调用 / 100k token
# 物理硬上限靠 API 充值额度控制(每次只充一点用完再充)
TRIAL_MAX_ROUNDS=30
TRIAL_MAX_TOKENS=100000

# 试用总额度(每用户), 管理员可针对单用户覆盖此值
TRIAL_DEFAULT_LIMIT=5

# trial_token 有效期(秒): 一次发送内 Agent 多轮工具调用复用此 token 免重复扣次数
TRIAL_TOKEN_TTL=900

# trial_token 签名密钥(可选; 不填则用 SUPABASE_SERVICE_ROLE_KEY 兜底。生产建议单独设)
# 生成: openssl rand -hex 32
TRIAL_TOKEN_SECRET=

# ── Supabase ──
# 前端 + 后端共用(anon key 可公开, 受 RLS 保护)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 仅后端用(绕过 RLS 做原子扣减 + 管理员操作), 绝不暴露给前端
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── 管理员 ──
# 管理员邮箱(逗号分隔), 首次登录自动设 is_admin=true
ADMIN_EMAILS=you@example.com

# ── 日志/会话持久化 ──
# 是否把交互日志写入 Supabase sessions 表(用于收集迭代数据)
ENABLE_SESSION_LOGGING=true
